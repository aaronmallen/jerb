#!/usr/bin/env sh
#MISE description="Publish Jerb crates to crates.io and Forgejo"

set -eu

publish() {
  status=$(curl --user-agent 'jerb-publish (https://aaronmallen.dev/aaron/jerb)' --silent --show-error --output /dev/null --write-out '%{http_code}' "$2")
  case "$status" in
  200) printf '%s %s already exists on %s\n' "$package" "$version" "$1" ;;
  404) cargo publish --locked --registry "$1" --package "$package" ;;
  *)
    printf 'Cannot check %s: HTTP %s\n' "$1" "$status" >&2
    exit 1
    ;;
  esac
}

for package in jerb-macros jerb; do
  package_id=$(cargo pkgid --package "$package")
  version=${package_id##*#}
  version=${version##*@}
  publish crates-io "https://crates.io/api/v1/crates/$package/$version"
  publish forgejo "https://aaronmallen.dev/api/v1/packages/aaron/cargo/$package/$version"
done
