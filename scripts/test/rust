#!/usr/bin/env sh
#MISE description="Run all rust tests"
#MISE alias=["t:rs", "t:rust", "test:rs"]
#USAGE flag "-f --filter <filter>" help="Filter tests by name"

set -e

set --

if [ -n "${usage_filter:-}" ]; then
  set -- "$@" --no-fail-fast --filter-expr "test(/${usage_filter}/)"
fi

cargo llvm-cov nextest --workspace --summary-only --all-features --no-tests pass "$@"
cargo llvm-cov report --html --output-dir coverage/rust
cargo llvm-cov report --cobertura --output-path coverage/rust/cobertura.xml
